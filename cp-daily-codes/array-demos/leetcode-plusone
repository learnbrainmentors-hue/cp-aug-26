class Solution {
public:
    vector<int> plusOne(vector<int>& digits) {
        for(int i = digits.size()-1; i>=0; i--){
            if(digits[i] == 9){
                digits[i] = 0;
            }
            else{
                digits[i]++;
                return digits;
            }
        }
        // it means everything is 9
        vector<int> v2 (digits.size()+1, 0);
        v2[0] = 1;
        return v2;
    }
};
