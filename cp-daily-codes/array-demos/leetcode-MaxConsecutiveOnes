class Solution {
public:
    int findMaxConsecutiveOnes(vector<int>& nums) {
        int count = 0;
        int maxStreak = 0;
        for(int val : nums){
            if(val == 1){
                count++;
                maxStreak = max(maxStreak, count);
            }
            else{
                count =0;
            }
        }
        return maxStreak;
    }
};
