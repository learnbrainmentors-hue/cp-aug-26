// The API isBadVersion is defined for you.
// bool isBadVersion(int version);

class Solution {
public:
    int firstBadVersion(int n) {
        int low = 1;
        int high = n;
        int answer =n;
        while(low<=high){
            int mid = low + (high -low)/2;
            if(isBadVersion(mid)){
                answer = mid;
                high = mid -1; // keep looking of first bad in left
            }
            else{
                low = mid + 1;
            }
        }
        return answer;
    }
};
