class Solution {
public:
    int pivotIndex(vector<int>& nums) {
        int total = 0;
        // Precompute
        for(int i = 0; i<nums.size(); i++){
            total = total + nums[i];
        }
        int leftSum = 0;
        for(int i = 0; i<nums.size(); i++){
            int rightSum = total - leftSum - nums[i];
            if(leftSum == rightSum){
                return i;
            }
            leftSum = leftSum + nums[i];
        }

        
        return -1;
    }
};
