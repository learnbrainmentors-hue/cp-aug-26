class Solution {
public:
    void setZeroes(vector<vector<int>>& matrix) {
        // find out the bomb index
        vector<bool> rowBomb (matrix.size(), false);
        vector<bool> colBomb (matrix[0].size(), false);
        for(int r = 0; r<matrix.size(); r++){
            for(int c = 0; c<matrix[0].size(); c++){
                if(matrix[r][c] == 0){
                    rowBomb[r] = true;
                    colBomb[c] = true;
                }
            } 
        }
        for(int r = 0; r<matrix.size(); r++){
            for(int c = 0; c<matrix[0].size(); c++){
                if(rowBomb[r] || colBomb[c]){
                    matrix[r][c] = 0;
                }
            }
        }

    }
};
