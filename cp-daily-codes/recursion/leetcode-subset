class Solution {
    public List<List<Integer>> subsets(int[] nums) {
        List<List<Integer>> big = new Vector<>();
        List<Integer> small = new Vector<>();
        helper(nums, 0, small, big);
        return big;
    }

    
    void helper(int[] nums, int index,List<Integer> small,List<List<Integer>> big ){
        big.add(new Vector<>(small));
        for(int i = index ; i<nums.size(); i++){
            small.add(nums[i]);
            helper(nums, i + 1, small, big);
            small.remove(small.size()-1);
        }
    }
}
