class Solution {
    
public:
    vector<vector<int>> permute(vector<int>& nums) {
        vector<int> small ;
        vector<vector<int>> big;
        vector<bool> isvisited (nums.size(), false);
        helper(nums, small, big, isvisited);
        return big;
    }
    /*
    bool contains(vector<int>& small, int val, ){
        for(int v : small){
            if(v == val){
                return true;
            }
        }
        return false;
    }*/
    void helper(vector<int>& nums, vector<int>& small, vector<vector<int>>& big, vector<bool>& isvisited){
        // base case
        if(nums.size() == small.size()){
            big.push_back(small);
            return ;
        }
        for(int i = 0; i<nums.size(); i++){
            if(!isvisited[i]){
            //if(!contains(small, val)){
            small.push_back(nums[i]);
            isvisited[i]= true;
            helper(nums, small, big, isvisited);
            small.pop_back();
            isvisited[i]= false;
            }
        }
    }
    
};
